{
  "name": "gladys-mg-ismart",
  "version": "0.1.1",
  "private": true,
  "description": "MG cars (MG4, ZS EV, MG5, Marvel R…) for Gladys Assistant through the SAIC iSMART cloud (Europe): battery, range, charge, odometer, locks, doors, boot, position, cabin temperature, climate; lock, unlock, boot, climate and charge buttons behind off-by-default options.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "audit": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LM1LC3N7/gladys-mg-ismart.git"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "license": "Apache-2.0"
}
